# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Xenon backend API base URL where /analyze is available
# Local default when backend is running on same machine:
BACKEND_API_URL=http://127.0.0.1:8000

# Max IFC upload size the bot will accept (MB)
MAX_FILE_SIZE_MB=20

# Timeout for backend analyze request (seconds)
REQUEST_TIMEOUT_SEC=120

# Polling interval for telegram updates (seconds)
POLL_INTERVAL=1.0
